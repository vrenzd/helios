      "source": [
        "import cv2\n",
        "import time\n",
        "import math\n",
        "from ultralytics import YOLO\n",
        "\n",
        "\n",
        "# 1. Função Matemática de Mapeamento Balístico\n",
        "def map_range(x, in_min, in_max, out_min, out_max):\n",
        "    # Mapeia coordenadas de pixel para a escala de ângulos dos servomotores.\n",
        "    return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min\n",
        "\n",
        "\n",
        "# 2. Carregar o cérebro do DataButcher\n",
        "model = YOLO(\"best.pt\")\n",
        "\n",
        "print(\"Dependências, Funções e Pesos carregados com sucesso.\")"
        "from ultralytics import YOLO\n",
        "\n",
        "# Carrega os pesos otimizados do seu treinamento\n",
        "# Certifique-se de que o arquivo 'best.pt' está no mesmo diretório deste notebook\n",
        "model = YOLO('yolo26n.pt')\n",
        "\n",
        "print(\"Modelo carregado com sucesso! Preparando módulo de visão...\")"
      ]
    },
    {
      "cell_type": "code",
